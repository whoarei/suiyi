<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="TranslationDialog" parent="android:style/Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">60%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowBackground">@drawable/translation_surface</item>
        <item name="android:backgroundDimAmount">0.24</item>
        <item name="android:windowSoftInputMode">stateAlwaysHidden|adjustResize</item>
    </style>
</resources>
