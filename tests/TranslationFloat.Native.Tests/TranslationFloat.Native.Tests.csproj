<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/TranslationFloat.App/NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="../../src/TranslationFloat.App/TranslationSettingsStore.cs" Link="TranslationSettingsStore.cs" />
    <Compile Include="../../src/TranslationFloat.App/StartupRegistration.cs" Link="StartupRegistration.cs" />
    <Compile Include="../../src/TranslationFloat.App/QuickModeSettingsStore.cs" Link="QuickModeSettingsStore.cs" />
    <Compile Include="../../src/TranslationFloat.App/HotKeySettingsStore.cs" Link="HotKeySettingsStore.cs" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="../../src/TranslationFloat.Core/TranslationFloat.Core.csproj" />
    <ProjectReference Include="../../src/TranslationFloat.App/TranslationFloat.App.csproj" Aliases="AppRuntime" />
  </ItemGroup>
</Project>
