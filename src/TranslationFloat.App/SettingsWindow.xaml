<Window x:Class="TranslationFloat.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译设置" Icon="Assets/Suiyi.ico" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FAFCFA" FontFamily="Segoe UI, Microsoft YaHei"
        Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
  <StackPanel Margin="20">
    <Label Content="DeepSeek API Key" Target="{Binding ElementName=ApiKeyBox}" Padding="0" Margin="0,0,0,7" />
    <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="DeepSeek API Key" AutomationProperties.AutomationId="DeepSeekApiKey" Padding="9" FontSize="15" MaxLength="512" />
    <TextBlock x:Name="KeyHint" TextWrapping="Wrap" Foreground="#748278" FontSize="11" Margin="0,7,0,16" />
    <Label Content="模型" Target="{Binding ElementName=ModelBox}" Padding="0" Margin="0,0,0,7" />
    <ComboBox x:Name="ModelBox" AutomationProperties.Name="DeepSeek 模型" Padding="7" FontSize="14">
      <ComboBoxItem Content="deepseek-flash" />
      <ComboBoxItem Content="deepseek-v4-pro" />
    </ComboBox>
    <TextBlock x:Name="TestStatus" AutomationProperties.AutomationId="ConnectionStatus" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#66796C" FontSize="12" Margin="0,10,0,0" />
    <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" AutomationProperties.AutomationId="TestConnection" />
      <Button x:Name="SaveButton" Grid.Column="2" Content="保存" Click="Save_Click" Background="#087A50" Foreground="White" BorderBrush="#087A50" AutomationProperties.AutomationId="SaveSettings" />
    </Grid>
  </StackPanel>
</Window>
