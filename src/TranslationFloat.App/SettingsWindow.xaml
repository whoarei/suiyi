<Window x:Class="TranslationFloat.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 设置" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FAFCFA" FontFamily="Segoe UI, Microsoft YaHei"
        Closed="Window_Closed">
  <StackPanel Margin="24">
    <TextBlock Text="连接 DeepSeek" FontSize="19" FontWeight="SemiBold" Foreground="#23382B" />
    <TextBlock Text="输入中文后，原文会通过你的 DeepSeek 账号翻译成英语。" TextWrapping="Wrap" Foreground="#66796C" FontSize="12" Margin="0,8,0,20" />
    <Label Content="API Key" Target="{Binding ElementName=ApiKeyBox}" Padding="0" Margin="0,0,0,7" />
    <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="DeepSeek API Key" AutomationProperties.AutomationId="DeepSeekApiKey" Padding="9" FontSize="15" MaxLength="512" />
    <TextBlock x:Name="KeyHint" TextWrapping="Wrap" Foreground="#748278" FontSize="11" Margin="0,7,0,16" />
    <Label Content="模型" Target="{Binding ElementName=ModelBox}" Padding="0" Margin="0,0,0,7" />
    <ComboBox x:Name="ModelBox" AutomationProperties.Name="DeepSeek 模型" Padding="7" FontSize="14">
      <ComboBoxItem Content="deepseek-flash" />
      <ComboBoxItem Content="deepseek-v4-pro" />
    </ComboBox>
    <TextBlock Text="默认使用 Flash。翻译时关闭思考模式，只返回译文。" TextWrapping="Wrap" Foreground="#748278" FontSize="11" Margin="0,7,0,16" />
    <TextBlock x:Name="TestStatus" AutomationProperties.AutomationId="ConnectionStatus" Text="密钥使用当前 Windows 用户加密保存。" TextWrapping="Wrap" MinHeight="40" Foreground="#66796C" FontSize="12" />
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" AutomationProperties.AutomationId="TestConnection" />
      <Button Grid.Column="2" Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
      <Button x:Name="SaveButton" Grid.Column="3" Content="保存" Click="Save_Click" Background="#087A50" Foreground="White" BorderBrush="#087A50" AutomationProperties.AutomationId="SaveSettings" />
    </Grid>
  </StackPanel>
</Window>
