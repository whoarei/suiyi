<Window x:Class="TranslationFloat.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随译" Icon="Assets/Suiyi.ico" Width="380" SizeToContent="Height"
        MinWidth="340" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        AutomationProperties.AutomationId="TranslationPopup"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated"
        Closing="Window_Closing">
  <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="10" Margin="8" Padding="14,8,14,12">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" /></Border.Effect>
    <StackPanel>
      <Grid MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent" Margin="0,0,-6,4">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="中文 → 英语" FontSize="11" Foreground="{DynamicResource Theme.Muted}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="×" Click="Close_Click" Padding="6,0" FontSize="18" Background="Transparent" BorderThickness="0" ToolTip="收起 · Esc" AutomationProperties.Name="收起" />
      </Grid>
      <Grid Margin="0,0,0,10">
        <TextBox x:Name="DraftText" AutomationProperties.AutomationId="DraftText" AutomationProperties.Name="中文原文"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                 Padding="0,3" FontSize="16" Foreground="{DynamicResource Theme.Text}" Background="Transparent" BorderThickness="0"
                 MaxLength="2000" TextChanged="Draft_TextChanged" />
        <TextBlock x:Name="DraftPlaceholder" Text="输入中文" Foreground="{DynamicResource Theme.Placeholder}" FontSize="16" Margin="0,3,0,0" IsHitTestVisible="False" />
      </Grid>
      <Border BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <Grid>
          <TextBox x:Name="TranslationText" AutomationProperties.AutomationId="TranslationText" AutomationProperties.Name="英语译文"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="144" VerticalScrollBarVisibility="Auto"
                   Padding="0,3" FontSize="16" Foreground="{DynamicResource Theme.Text}" Background="Transparent" BorderThickness="0"
                   MaxLength="8000" IsReadOnly="True" TextChanged="Translation_TextChanged" />
          <TextBlock x:Name="ResultPlaceholder" Text="译文" Foreground="{DynamicResource Theme.Placeholder}" FontSize="16" Margin="0,3,0,0" IsHitTestVisible="False" />
        </Grid>
      </Border>
      <Grid x:Name="FeedbackPanel" Visibility="Collapsed" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="FeedbackText" AutomationProperties.AutomationId="Feedback" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="RetryButton" Grid.Column="1" Content="重试" Click="Retry_Click" Visibility="Collapsed" Padding="7,3" FontSize="12" Margin="8,0,0,0" />
        <Button x:Name="ConfigureButton" Grid.Column="2" Content="设置" Click="Settings_Click" Visibility="Collapsed" Padding="7,3" FontSize="12" Margin="8,0,0,0" />
      </Grid>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="TargetText" AutomationProperties.AutomationId="TargetText" Foreground="{DynamicResource Theme.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button x:Name="CopyButton" Grid.Column="1" Click="Copy_Click" Padding="8,6" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" ToolTip="复制译文" AutomationProperties.Name="复制译文" AutomationProperties.AutomationId="CopyButton">
          <Canvas Width="14" Height="14"><Rectangle Canvas.Left="1" Canvas.Top="1" Width="8" Height="9" RadiusX="1" RadiusY="1" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1" /><Rectangle Canvas.Left="5" Canvas.Top="4" Width="8" Height="9" RadiusX="1" RadiusY="1" Fill="{DynamicResource Theme.Surface}" Stroke="{DynamicResource Theme.Muted}" StrokeThickness="1" /></Canvas>
        </Button>
        <Button x:Name="PrimaryButton" Grid.Column="2" Content="复制" Click="Primary_Click" Padding="13,6" Background="{DynamicResource Theme.Accent}" Foreground="{DynamicResource Theme.OnAccent}" BorderBrush="{DynamicResource Theme.Accent}" IsEnabled="False" AutomationProperties.AutomationId="PrimaryButton" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
