<Window x:Class="TranslationFloat.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随译 · DeepSeek 翻译" Width="450" SizeToContent="Height"
        MinWidth="360" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        AutomationProperties.AutomationId="TranslationPopup"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated"
        Closing="Window_Closing">
  <Border Background="#FFFFFF" BorderBrush="#D9E4DD" BorderThickness="1" CornerRadius="11" Margin="8">
    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="16,12,12,8" MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#E8F6EE" Padding="7,4" CornerRadius="5"><TextBlock Text="译" Foreground="#087A50" FontWeight="SemiBold" /></Border>
          <TextBlock Text="随译" FontSize="14" FontWeight="SemiBold" Foreground="#23382B" Margin="9,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="边写边译" FontSize="11" Foreground="#738278" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="1" Content="设置" Click="Settings_Click" Padding="8,5" FontSize="12" Background="Transparent" BorderThickness="0" AutomationProperties.Name="DeepSeek 设置" />
        <Button Grid.Column="2" Content="×" Click="Close_Click" Padding="9,3" FontSize="17" Background="Transparent" BorderThickness="0" AutomationProperties.Name="收起并保留草稿" />
      </Grid>
      <Border Grid.Row="1" BorderBrush="#E3EAE5" BorderThickness="0,0,0,1" Padding="16,0,16,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="中文 → 英语" Foreground="#526B5B" FontSize="12" />
          <TextBlock x:Name="ProviderText" Grid.Column="1" Text="DeepSeek · 未配置" Foreground="#738278" FontSize="11" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="2" Margin="16,14,16,10">
        <Label Target="{Binding ElementName=DraftText}" Content="中文原文" Padding="0" Foreground="#64776A" FontSize="12" Margin="0,0,0,9" />
        <TextBox x:Name="DraftText" AutomationProperties.AutomationId="DraftText" AutomationProperties.Name="中文原文"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                 Padding="8" FontSize="16" Foreground="#23382B" Background="#FAFCFA"
                 BorderBrush="#D7E1DB" BorderThickness="1" MaxLength="2000" TextChanged="Draft_TextChanged" />
      </StackPanel>
      <Border Grid.Row="3" Background="#F5FAF7" BorderBrush="#E3EAE5" BorderThickness="0,1,0,1" Padding="16,12,16,10">
        <StackPanel>
          <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Label Target="{Binding ElementName=TranslationText}" Content="英语译文" Padding="0" Foreground="#64776A" FontSize="12" />
            <TextBlock Grid.Column="1" Text="完成后可编辑" Foreground="#738278" FontSize="11" />
          </Grid>
          <TextBox x:Name="TranslationText" AutomationProperties.AutomationId="TranslationText" AutomationProperties.Name="英语译文"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                   Padding="5" FontSize="16" Foreground="#23382B" Background="Transparent" BorderThickness="0"
                   MaxLength="8000" IsReadOnly="True" TextChanged="Translation_TextChanged" />
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="TranslationStatusText" AutomationProperties.AutomationId="TranslationStatus" Text="输入中文，停顿后自动翻译。" TextWrapping="Wrap" FontSize="12" Foreground="#67776C" VerticalAlignment="Center" />
            <Button x:Name="RetryButton" Grid.Column="1" Content="重试" Click="Retry_Click" Padding="9,3" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed" />
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="4" Margin="16,11,16,0">
        <TextBlock x:Name="TargetText" AutomationProperties.AutomationId="TargetText" Text="复制模式 · 尚未绑定输入位置" Foreground="#68796E" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="在目标输入框按 Ctrl+Alt+T 唤出。" TextWrapping="Wrap" FontSize="11" Foreground="#78877E" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="5" Margin="16,10,16,15">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button x:Name="CopyButton" Content="复制译文" Click="Copy_Click" IsEnabled="False" AutomationProperties.AutomationId="CopyButton" />
          <Button x:Name="InsertButton" Grid.Column="2" Content="填入原输入框  Ctrl ↵" Click="Insert_Click" Background="#087A50" Foreground="White" BorderBrush="#087A50" IsEnabled="False" AutomationProperties.AutomationId="InsertButton" />
        </Grid>
        <TextBlock Text="Enter 换行    Esc 收起并保留草稿" Foreground="#78877E" FontSize="11" Margin="0,12,0,0" />
        <TextBlock Text="回填后由你确认发送；译文会留在剪贴板。" Foreground="#78877E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
