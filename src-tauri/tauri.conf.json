{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "随译",
  "version": "0.4.1",
  "identifier": "Suiyi.Desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["../src/TranslationFloat.App/Assets/Suiyi.ico"],
    "publisher": "whoarei",
    "homepage": "https://github.com/whoarei/suiyi",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
